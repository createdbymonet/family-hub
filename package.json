{
  "name": "family-hub",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --ssl --host localhost --proxy-config proxy.conf.json",
    "start": "pnpm dev",
    "dev:worker": "wrangler dev --local --local-protocol https --ip localhost --port 8787 --var APP_ORIGIN:https://localhost:4200",
    "build": "ng build",
    "deploy": "pnpm build && wrangler deploy --config wrangler.jsonc",
    "deploy:check": "pnpm build && wrangler deploy --config wrangler.jsonc --dry-run",
    "watch": "ng build --watch --configuration development",
    "test": "pnpm test:ui && pnpm test:worker && pnpm test:bootstrap",
    "test:ui": "ng test --watch=false",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:bootstrap": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:worker",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:worker": "pnpm types:worker && tsc --noEmit -p tsconfig.worker.json",
    "types:worker": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --strict-vars false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:bootstrap": "node scripts/bootstrap-users.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": ">=11.21.0"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "jose": "^6.2.18",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.0",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@types/node": "^24.19.2",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12",
    "wrangler": "4.152.0"
  }
}
